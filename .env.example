# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Used by api/ingest.js (separate from NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=http://localhost:3004/auth/callback

# ── Supabase wake endpoint (optional, used by api/db-wake.js) ──
FULLSTACK_PROJECT_REF=your-project-ref
FULLSTACK_RESTORE_API_URL=https://your-project.supabase.co/restore

# ── Free LLM chain ($0 forever — no paid key, no expiring credits needed) ──
# Order: Groq -> Nvidia NIM -> Cerebras -> OpenRouter -> Gemini
#        -> Ollama local -> Pollinations keyed -> Pollinations anonymous.
# The app works with ALL of these empty (Pollinations anonymous + local templates).
# TIP: any *_KEY variable accepts comma-separated keys ("k1,k2") — each key has
# its own free quota, so 2 keys = 2x limits with zero new providers.
# Permanent free lanes (pick any, all no credit card):
#   Groq      https://console.groq.com          (per-model buckets; scout ~30K TPM)
#   Nvidia    https://build.nvidia.com          (email signup, ~40 RPM free)
#   OpenRouter https://openrouter.ai/keys       (20+ :free models incl. Gemma 4 free)
#   Gemini    https://aistudio.google.com       (Gemma 4 + Gemini flash free tier)
#   Pollinations https://enter.pollinations.ai  (free sk_ upgrades weakest lane)
# and/or run Ollama locally (`ollama serve && ollama pull gemma4:e4b`).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: Groq free-tier key (llama-4-scout + gpt-oss + Qwen rotation).
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional: Nvidia NIM key (build.nvidia.com) for overflow (~40 RPM free).
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
# (NIM_API_KEY / NEMOTRON_OCR_API_KEY from older setups work too — same keys.)
# Optional: Pollinations secret key (sk_) for reliable chat-completions lane.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
# Optional: Cerebras key (OpenAI-compatible, fastest inference).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gemma-4-31b-it
# Optional: OpenRouter key (OpenAI-compatible, real Gemma 4 free tiers).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: fully-offline local LLM (no key). Gemma 4 edge: `ollama pull gemma4:e4b`.
# Larger workstation options: `ollama pull gemma4:12b` / `gemma4:26b` / `gemma4:31b`.
# Vision: `ollama pull moondream`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_VISION_MODEL=moondream

# ── Ingest speed controls (all optional, defaults shown) ──
# FAST_INGEST=1 skips figure vision + heavy LaTeX OCR (text+tables only, seconds).
# Default 0 = budgeted mode: largest INGEST_MAX_VISION_IMAGES figures only.
FAST_INGEST=0
INGEST_MAX_VISION_IMAGES=8
INGEST_MIN_IMAGE_BYTES=15000
INGEST_MAX_HEAVY_BYTES=150000
INGEST_HEAVY_TIMEOUT=60
# Caption/label figure crops (molecule diagrams): share the vision budget.
INGEST_MAX_CAPTION_FIGS=6
INGEST_MAX_LABEL_FIGS=4
# INGEST_HEAVY_OCR=0 disables pix2tex LaTeX OCR (saves ~1GB RAM — set on 4GB VMs).
INGEST_HEAVY_OCR=1
# CHEM_STRUCTURES=0 disables SMILES proposal for chemical figures.
# INGEST_MAX_STRUCTURES caps validated structures per document (each = 1 small LLM call).
CHEM_STRUCTURES=1
INGEST_MAX_STRUCTURES=4
# LLM_LOCAL_FIRST=1 prefers local Ollama over cloud free-tiers (slower, offline).
LLM_LOCAL_FIRST=0
# VISION_LOCAL_FIRST=1 prefers local Ollama vision (moondream) over Gemini
# vision (default cloud-first: seconds vs minutes on CPU).
VISION_LOCAL_FIRST=0
# RDKit (structure validation) is OPTIONAL and NOT in requirements.txt:
#   pip install rdkit   (local + VM: safe to add, import-guarded if absent)

# ── Server config (VM deployment) ──
PORT=3004
