# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Used by api/ingest.js (separate from NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=http://localhost:3004/auth/callback

# ── Supabase wake endpoint (optional, used by api/db-wake.js) ──
FULLSTACK_PROJECT_REF=your-project-ref
FULLSTACK_RESTORE_API_URL=https://your-project.supabase.co/restore

# ── Gemini API (used by Node.js API routes + Python ingest_cli.py) ──
# The ONLY source for generation & evaluation. No fallback.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── Server config (VM deployment) ──
PORT=3004
